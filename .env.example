# Copy to .env and fill in before `docker compose up -d`.
#
#   cp .env.example .env
#
# Generate all three secrets at once:
#
#   { echo "POSTGRES_PASSWORD=$(openssl rand -hex 16)"
#     echo "EZFD_DB_PASSWORD=$(openssl rand -hex 16)"
#     echo "EZFD_ENCRYPTION_KEY=$(openssl rand -hex 32)"; } >> .env
#
# .env is gitignored. Keep it — EZFD_ENCRYPTION_KEY especially. It encrypts the
# stored QRZ password, and a backup does not contain it by design, so losing it
# means re-entering QRZ credentials rather than losing a log.

# The database superuser. Used only by the db-init service to create the role,
# create the database and apply the schema.
POSTGRES_PASSWORD=

# The application's own database role. Granted DML only — it owns no tables.
EZFD_DB_PASSWORD=

# 32 bytes of hex. Encrypts the per-event QRZ password at rest.
EZFD_ENCRYPTION_KEY=

# Leave blank to let anyone who can reach the server create an event, which is
# the usual choice on a private field LAN. Set it to require the key.
EZFD_ADMIN_KEY=

# The port operators connect to. 80 means they type a hostname and nothing
# else; change it if something already has port 80 on the machine.
EZFD_PORT=80
