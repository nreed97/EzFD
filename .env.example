# ─────────────────────────────────────────────────────────────────────────────
# EzFD — settings for the Docker Compose install.
#
#   cp .env.example .env
#   chmod 600 .env
#
# then fill in the three required values below, and start it with
#
#   docker compose up -d
#
# compose.yaml reads this file from the same directory. Every setting is
# described in docs/configuration.md → "The Docker Compose .env".
# A deploy.sh install does not use this file; it writes /opt/ezfd/.env itself.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Generate each with the command beside it. Keep them to letters and digits:
# EZFD_DB_PASSWORD goes into a connection URL, where punctuation means things.

# The database superuser's password (openssl rand -hex 24). Read only when the
# database is first created, so changing it afterwards locks the schema step
# out rather than changing the password.
POSTGRES_PASSWORD=

# The app's own database password (openssl rand -hex 24). Safe to change; it
# is re-applied on every start.
EZFD_DB_PASSWORD=

# Encrypts stored QRZ passwords (openssl rand -hex 32, 64 hex characters).
# When moving from a deploy.sh install, copy the value from /opt/ezfd/.env.
EZFD_ENCRYPTION_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Which version of EzFD to build: a branch, a tag or a commit of the GitHub
# repository. Blank builds master. Run `docker compose up -d` again after
# changing it.
EZFD_REF=

# Where to build from, replacing the GitHub repository and EZFD_REF entirely.
# Set to . to build from the checkout this file sits in, or to a fork's URL
# with its own #branch. Blank uses https://github.com/nreed97/EzFD.git#EZFD_REF.
EZFD_SOURCE=

# The domain to obtain a TLS certificate for. Leave blank to serve plain HTTP
# on port 80 by IP address or any name, as an offline field server does.
EZFD_DOMAIN=

# If set, creating an event requires this key. Leave blank to allow anyone who
# can reach the site to create events.
EZFD_ADMIN_KEY=

# Host ports for the proxy. A certificate needs both at their defaults.
EZFD_HTTP_PORT=80
EZFD_HTTPS_PORT=443

# Override where the N1MM call history and MASTER.SCP files are fetched from.
# The call history URLs accept a {year} placeholder. Blank uses the defaults.
EZFD_FD_CALL_HISTORY_URL=
EZFD_WFD_CALL_HISTORY_URL=
EZFD_MASTER_SCP_URL=
